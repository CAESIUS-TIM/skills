#!/usr/bin/env bash
# Full-history leak scan, then the complete check suite.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 1
if ! command -v gitleaks >/dev/null 2>&1; then
    echo "gitleaks required: pacman -S gitleaks (or see https://github.com/gitleaks/gitleaks)"
    exit 1
fi
gitleaks git . --redact --no-banner -v --config .gitleaks.toml
just check
